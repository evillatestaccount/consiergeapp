# ==============================================================================
# EscortVilla Application Environment Variables - Example Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Neon PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Pooled connection string (for queries via PgBouncer with cold-start & pool timeouts)
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-7.us-east-2.aws.neon.tech/consierge?channel_binding=require&sslmode=require&connect_timeout=15&pool_timeout=15"

# Direct unpooled connection string (used by Prisma for migrations and schema push)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.c-7.us-east-2.aws.neon.tech/consierge?channel_binding=require&sslmode=require"

# Active Neon branch
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# Neon Object Storage (S3-compatible)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID="nak_live_your_access_key_id"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_access_key"
AWS_ENDPOINT_URL_S3="https://br-example.storage.c-7.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"
NEON_OBJECT_STORAGE_BUCKET="assets"

# ------------------------------------------------------------------------------
# Cloudinary Configuration
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="899787571845291"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# App & Security Configuration
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-secure-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
REVALIDATION_TOKEN="secure-reval-token"

# ------------------------------------------------------------------------------
# Analytics & Search Console (SEO)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console Verification code (from html tag content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
ADMIN_EMAIL="admin@escortvilla.com"
